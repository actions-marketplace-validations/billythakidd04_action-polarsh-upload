# Polar Organization Access Token (OAT)
POLAR_ACCESS_TOKEN=polar_oat_your_token_here

# Local file path to the release archive
FILE_PATH=/tmp/test-polar-release.zip

# Server environment: 'production' or 'sandbox'
POLAR_SERVER=sandbox

# Optional Polar Downloadable Benefit ID
POLAR_BENEFIT_ID=your_benefit_id_here

# Optional Polar Organization ID (automatically resolved if omitted)
# POLAR_ORGANIZATION_ID=your_organization_id_here
